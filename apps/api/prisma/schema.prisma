generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Business (multi-tenant par user) ────────────────────────────────────────

model Business {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @map("user_id")
  name          String
  sector        String?
  country       String   @default("CD")
  currency      String   @default("USD")
  whatsappPhone String   @map("whatsapp_phone")
  phone         String?  @map("phone")
  city          String?  @map("city")
  logoUrl       String?  @map("logo_url")
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("businesses")
}

model Product {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  sku             String
  category        String   @default("")
  quantity        Float    @default(0)
  alertThreshold  Float    @default(5)  @map("alert_threshold")
  supplier        String   @default("")
  acquisitionCost Float    @default(0)  @map("acquisition_cost")
  sellingPrice    Float    @default(0)  @map("selling_price")
  imageUrl        String?  @map("image_url")
  entryDate       DateTime @map("entry_date") @db.Date
  trackStock      Boolean  @default(true) @map("track_stock")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt     @map("updated_at")
  userId          String?  @map("user_id")
  businessId      String?  @map("business_id") @db.Uuid

  movements      StockMovement[]
  saleItems      SaleItem[]
  expenses       Expense[]
  storeItems     StoreProduct[]
  media          ProductMedia[]
  orderItems     ManualOrderItem[]
  locationStocks LocationStock[]
  waMentions     WhatsAppProductMention[]

  @@unique([userId, sku])
  @@index([userId])
  @@index([businessId])
  @@map("products")
}

model StockMovement {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  type       String
  quantity   Float
  reason     String   @default("")
  date       DateTime @db.Date
  createdAt  DateTime @default(now()) @map("created_at")
  userId     String?  @map("user_id")
  businessId String?  @map("business_id") @db.Uuid

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([businessId])
  @@map("stock_movements")
}

model Sale {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  channel       String
  date          DateTime   @db.Date
  note          String?
  status        String     @default("paid")
  deliveryZone  String?    @map("delivery_zone")
  customerName  String?    @map("customer_name")
  customerPhone String?    @map("customer_phone")
  createdAt     DateTime   @default(now()) @map("created_at")
  userId        String?    @map("user_id")
  businessId    String?    @map("business_id") @db.Uuid

  items SaleItem[]

  @@index([userId])
  @@index([businessId])
  @@map("sales")
}

model SaleItem {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  saleId    String   @map("sale_id") @db.Uuid
  productId String?  @map("product_id") @db.Uuid
  quantity  Float
  unitPrice Float    @map("unit_price")

  sale    Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@map("sale_items")
}

model Expense {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category    String
  productId   String?  @map("product_id") @db.Uuid
  channel     String?
  amount      Float
  description String   @default("")
  date        DateTime @db.Date
  createdAt   DateTime @default(now()) @map("created_at")
  userId      String?  @map("user_id")
  businessId  String?  @map("business_id") @db.Uuid

  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([businessId])
  @@map("expenses")
}

model SalesGoal {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId  String   @map("product_id")
  targetQty  Int      @default(1) @map("target_qty")
  createdAt  DateTime @default(now()) @map("created_at")
  userId     String?  @map("user_id")
  businessId String?  @map("business_id") @db.Uuid

  @@index([userId])
  @@index([businessId])
  @@map("sales_goals")
}

// ─── WhatsApp CRM ─────────────────────────────────────────────────────────────

model WhatsAppSession {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @unique @map("user_id")
  businessId String?  @map("business_id") @db.Uuid
  authState  Json?    @map("auth_state")
  connected  Boolean  @default(false)
  phone      String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([businessId])
  @@map("wa_sessions")
}

model WaBaileyAuthKey {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id")
  keyType   String   @map("key_type")
  keyId     String   @map("key_id")
  keyData   Json     @map("key_data")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, keyType, keyId])
  @@map("wa_baileys_keys")
}

model WhatsAppContact {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String    @map("user_id")
  businessId      String?   @map("business_id") @db.Uuid
  phone           String
  displayName     String?   @map("display_name")
  isRead          Boolean   @default(false) @map("is_read")
  isArchived      Boolean   @default(false) @map("is_archived")
  assignedAgent   String?   @map("assigned_agent")
  lastMessageAt   DateTime? @map("last_message_at")
  lastMessageText String?   @map("last_message_text")
  leadStatus      String    @default("cold") @map("lead_status")
  leadScore       Int       @default(0) @map("lead_score")
  leadName        String?   @map("lead_name")
  leadNeed        String?   @map("lead_need")
  leadBudget      String?   @map("lead_budget")
  leadCity        String?   @map("lead_city")
  leadUrgency     String?   @map("lead_urgency")
  leadProduct     String?   @map("lead_product")
  aiEnabled       Boolean   @default(true) @map("ai_enabled")
  source          String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  messages WhatsAppMessage[]
  notes    WhatsAppNote[]
  tags     WhatsAppContactTag[]
  mentions WhatsAppProductMention[]

  @@unique([userId, phone])
  @@index([userId])
  @@index([businessId])
  @@map("wa_contacts")
}

model WhatsAppMessage {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @map("user_id")
  businessId   String?  @map("business_id") @db.Uuid
  contactId    String   @map("contact_id") @db.Uuid
  waId         String?  @map("wa_id")
  direction    String
  content      String
  mediaUrl     String?  @map("media_url")
  mediaType    String?  @map("media_type")
  quotedMsgId  String?  @map("quoted_msg_id")
  ack          Int      @default(0)
  fromAi       Boolean  @default(false) @map("from_ai")
  automationId String?  @map("automation_id")
  sentAt       DateTime @map("sent_at")
  createdAt    DateTime @default(now()) @map("created_at")

  contact WhatsAppContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([userId, waId])
  @@index([contactId])
  @@index([businessId])
  @@map("wa_messages")
}

model WhatsAppNote {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contactId  String   @map("contact_id") @db.Uuid
  userId     String   @map("user_id")
  businessId String?  @map("business_id") @db.Uuid
  content    String
  createdAt  DateTime @default(now()) @map("created_at")

  contact WhatsAppContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@map("wa_notes")
}

model WhatsAppTag {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id")
  businessId String?  @map("business_id") @db.Uuid
  name       String
  color      String   @default("#6366f1")

  contacts WhatsAppContactTag[]

  @@unique([userId, name])
  @@index([businessId])
  @@map("wa_tags")
}

model WhatsAppContactTag {
  contactId String @map("contact_id") @db.Uuid
  tagId     String @map("tag_id") @db.Uuid

  contact WhatsAppContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag     WhatsAppTag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
  @@map("wa_contact_tags")
}

model WhatsAppAIConfig {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String   @unique @map("user_id")
  businessId          String?  @map("business_id") @db.Uuid
  enabled             Boolean  @default(true)
  systemPrompt        String   @default("") @map("system_prompt")
  businessObjective   String   @default("") @map("business_objective")
  brandPersonality    String   @default("") @map("brand_personality")
  primaryLanguage     String   @default("fr") @map("primary_language")
  blacklistTopics     String[] @map("blacklist_topics")
  escalationKeywords  String[] @map("escalation_keywords")
  escalationMessage   String   @default("Je vous transfère à un agent.") @map("escalation_message")
  activeHours         Json?    @map("active_hours")
  outsideHoursMessage String   @default("Nous sommes actuellement fermés.") @map("outside_hours_message")
  simulatedDelayMs    Int      @default(2000) @map("simulated_delay_ms")
  confidenceThreshold Float    @default(0.7) @map("confidence_threshold")
  deliveryAgentName   String   @default("") @map("delivery_agent_name")
  deliveryAgentPhone  String   @default("") @map("delivery_agent_phone")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("wa_ai_configs")
}

model WhatsAppProductMention {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String          @map("user_id")
  businessId  String?         @map("business_id") @db.Uuid
  contactId   String          @map("contact_id") @db.Uuid
  contact     WhatsAppContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  productId   String?         @map("product_id") @db.Uuid
  product     Product?        @relation(fields: [productId], references: [id])
  productName String          @map("product_name")
  messageText String?         @map("message_text")
  isConverted Boolean         @default(false) @map("is_converted")
  createdAt   DateTime        @default(now()) @map("created_at")

  @@index([userId])
  @@index([contactId])
  @@index([productId])
  @@map("wa_product_mentions")
}

model WhatsAppKBEntry {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @map("user_id")
  businessId    String?  @map("business_id") @db.Uuid
  category      String
  title         String
  content       String
  closingScript String?  @map("closing_script")
  imageUrl      String?  @map("image_url")
  productId     String?  @map("product_id")
  tags          String[]
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([businessId])
  @@map("wa_kb_entries")
}

model WhatsAppAutomation {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @map("user_id")
  businessId    String?  @map("business_id") @db.Uuid
  name          String
  enabled       Boolean  @default(true)
  trigger       String
  triggerConfig Json     @map("trigger_config")
  action        String
  actionConfig  Json     @map("action_config")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([businessId])
  @@map("wa_automations")
}

// ─── Catégories produits (gestion admin) ─────────────────────────────────────

model ProductCategory {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique
  slug      String   @unique
  active    Boolean  @default(true)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("product_categories")
}

// ─── Boutique en ligne ────────────────────────────────────────────────────────

model OnlineStore {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @unique @map("user_id")
  slug          String   @unique
  name          String
  description   String?
  logoUrl       String?  @map("logo_url")
  whatsappPhone String   @map("whatsapp_phone")
  primaryColor  String   @default("#6366f1") @map("primary_color")
  currency      String   @default("CDF") @map("currency")
  metaPixelId     String?  @map("meta_pixel_id")
  deliveryZones   Json?    @map("delivery_zones")
  active          Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  products StoreProduct[]
  orders   StoreOrder[]

  @@map("online_stores")
}

model StoreProduct {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId    String   @map("store_id") @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  storePrice       Decimal? @map("store_price") @db.Decimal(10, 2)
  comparePrice     Decimal? @map("compare_price") @db.Decimal(10, 2)
  bundleQty        Int?     @map("bundle_qty")
  bundlePrice      Decimal? @map("bundle_price") @db.Decimal(10, 2)
  storeDescription String?  @map("store_description")

  store   OnlineStore @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([storeId, productId])
  @@map("store_products")
}

model StoreOrder {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId       String   @map("store_id") @db.Uuid
  customerName  String   @map("customer_name")
  customerPhone String   @map("customer_phone")
  deliveryZone  String   @map("delivery_zone")
  items         Json
  totalAmount   Float    @map("total_amount")
  deliveryFee   Float    @default(0) @map("delivery_fee")
  notes         String?
  utmSource     String?  @map("utm_source")
  utmMedium     String?  @map("utm_medium")
  utmCampaign   String?  @map("utm_campaign")
  utmContent    String?  @map("utm_content")
  status        String   @default("pending")
  createdAt     DateTime @default(now()) @map("created_at")

  store OnlineStore @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@map("store_orders")
}

model ProductMedia {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  url       String
  type      String   @default("image")
  caption   String?
  audioUrl  String?  @map("audio_url")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_media")
}

// ─── Business AI ──────────────────────────────────────────────────────────────

model AiCallSession {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id")
  startedAt DateTime  @default(now()) @map("started_at")
  endedAt   DateTime? @map("ended_at")

  @@index([userId])
  @@map("ai_call_sessions")
}

model AiMessage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id")
  role      String
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("ai_messages")
}

// ─── Profil utilisateur ────────────────────────────────────────────────────────

model UserProfile {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @unique @map("user_id")
  businessSector String?  @map("business_sector")
  companyName    String?  @map("company_name")
  country        String?  @default("") @map("country")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("user_profiles")
}

// ─── Audience (contacts synchronisés depuis WhatsApp) ─────────────────────────

model WaCampaignContact {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId        String    @map("client_id")
  businessId      String?   @map("business_id") @db.Uuid
  phoneNumber     String    @map("phone_number")
  displayName     String?   @map("display_name")
  waAccountId     String?   @map("wa_account_id")
  businessSector  String?   @map("business_sector")
  source          String    @default("whatsapp_sync") @map("source")
  syncedAt        DateTime? @map("synced_at")

  consentStatus   String    @default("unknown") @map("consent_status")
  contactStatus   String    @default("active")  @map("contact_status")
  tags            String[]  @default([])
  segments        String[]  @default([])
  lastContactedAt DateTime? @map("last_contacted_at")

  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  campaignHistory WaCampaignContactHistory[]

  @@unique([clientId, phoneNumber])
  @@index([clientId])
  @@index([businessId])
  @@index([clientId, consentStatus])
  @@index([clientId, contactStatus])
  @@map("wa_campaign_contacts")
}

model WaCampaignContactHistory {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contactId  String   @map("contact_id") @db.Uuid
  campaignId String?  @map("campaign_id")
  action     String
  metadata   Json?
  occurredAt DateTime @default(now()) @map("occurred_at")

  contact WaCampaignContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@index([campaignId])
  @@map("wa_campaign_contact_history")
}

// ─── Logistique ────────────────────────────────────────────────────────────────

model StockLocation {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String          @map("user_id")
  businessId String          @map("business_id")
  name       String
  city       String
  address    String?
  type       String          @default("OWN")
  partnerId  String?         @unique @map("partner_id") @db.Uuid
  partner    DeliveryPartner? @relation(fields: [partnerId], references: [id])
  orders     ManualOrder[]
  stocks     LocationStock[]
  createdAt  DateTime        @default(now()) @map("created_at")

  @@index([userId])
  @@index([businessId])
  @@map("stock_locations")
}

model DeliveryPartner {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String          @map("user_id")
  businessId String          @map("business_id")
  name       String
  phone      String?
  city       String?
  type       String          @default("COMPANY")
  token      String          @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pin              String?
  whatsappGroupId  String?  @map("whatsapp_group_id")
  location         StockLocation?
  orders     ManualOrder[]
  agents     DeliveryAgent[]
  payments   PartnerPayment[]
  createdAt  DateTime        @default(now()) @map("created_at")

  @@index([userId])
  @@index([businessId])
  @@map("delivery_partners")
}

model PartnerPayment {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partnerId   String          @map("partner_id") @db.Uuid
  partner     DeliveryPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  amount      Decimal         @db.Decimal(10, 2)
  currency    String          @default("FC")
  proofUrl    String?         @map("proof_url")
  status      String          @default("pending")
  notes       String?
  confirmedAt DateTime?       @map("confirmed_at")
  confirmedBy String?         @map("confirmed_by")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@index([partnerId])
  @@map("partner_payments")
}

model DeliveryAgent {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partnerId String          @map("partner_id") @db.Uuid
  partner   DeliveryPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  name      String
  phone     String?
  orders    ManualOrder[]
  createdAt DateTime        @default(now()) @map("created_at")

  @@map("delivery_agents")
}

model ManualOrder {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String          @map("user_id")
  businessId         String          @map("business_id")
  orderNumber        Int             @default(0) @map("order_number")
  customerName       String          @map("customer_name")
  customerPhone      String?         @map("customer_phone")
  city               String
  address            String
  deliveryFee        Decimal         @map("delivery_fee") @db.Decimal(10, 2)
  totalAmount        Decimal         @map("total_amount") @db.Decimal(10, 2)
  status             String          @default("pending")
  isDraft            Boolean         @default(false) @map("is_draft")
  sourceContactId    String?         @map("source_contact_id") @db.Uuid
  partnerId          String?         @map("partner_id") @db.Uuid
  partner            DeliveryPartner? @relation(fields: [partnerId], references: [id])
  locationId         String?         @map("location_id") @db.Uuid
  location           StockLocation?  @relation(fields: [locationId], references: [id])
  notes              String?
  deliveryPersonName String?         @map("delivery_person_name")
  scheduledAt        DateTime?       @map("scheduled_at")
  dispatchedAt       DateTime?       @map("dispatched_at")
  agentId            String?         @map("agent_id") @db.Uuid
  agent              DeliveryAgent?  @relation(fields: [agentId], references: [id])
  collectedUsd          Decimal?        @map("collected_usd") @db.Decimal(10, 2)
  collectedCdf          Decimal?        @map("collected_cdf") @db.Decimal(10, 2)
  excludeFromRelance    Boolean         @default(false) @map("exclude_from_relance")
  relanceScheduledAt    DateTime?       @map("relance_scheduled_at")
  items              ManualOrderItem[]
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @default(now()) @updatedAt @map("updated_at")

  @@index([userId])
  @@index([businessId])
  @@map("manual_orders")
}

model ManualOrderItem {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId   String      @map("order_id") @db.Uuid
  order     ManualOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String      @map("product_id") @db.Uuid
  product   Product     @relation(fields: [productId], references: [id])
  quantity  Float
  unitPrice Decimal     @map("unit_price") @db.Decimal(10, 2)

  @@map("manual_order_items")
}

model LocationStock {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  locationId String        @map("location_id") @db.Uuid
  location   StockLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  productId  String        @map("product_id") @db.Uuid
  product    Product       @relation(fields: [productId], references: [id])
  quantity   Float         @default(0)
  updatedAt  DateTime      @updatedAt @map("updated_at")

  @@unique([locationId, productId])
  @@map("location_stocks")
}

// ─── Follow-up automatique (relance + fidélisation) ────────────────────────────

model WaFollowUpConfig {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String   @unique @map("user_id")
  relanceEnabled   Boolean  @default(false) @map("relance_enabled")
  relanceDelayH    Int      @default(24) @map("relance_delay_h")
  relanceTemplate  String   @default("Bonjour {{nom}}, votre commande #{{numero_commande}} ({{produit}}) n'a pas encore été livrée. Êtes-vous disponible pour la réception ?") @map("relance_template")
  loyaltyEnabled   Boolean  @default(false) @map("loyalty_enabled")
  loyaltyDelayH    Int      @default(24) @map("loyalty_delay_h")
  loyaltyTemplate  String   @default("Bonjour {{nom}} ! Merci pour votre commande #{{numero_commande}} 🙏. Nous espérons que {{produit}} vous satisfait. N'hésitez pas à nous partager votre avis !") @map("loyalty_template")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("wa_followup_configs")
}

model WaFollowUp {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id")
  orderId   String   @map("order_id") @db.Uuid
  type      String   // "relance" | "loyalty"
  phone     String
  message   String
  sentAt    DateTime @default(now()) @map("sent_at")

  @@unique([orderId, type])
  @@index([userId])
  @@map("wa_followups")
}

// ─── Push Notifications ───────────────────────────────────────────────────────

model PushSubscription {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id")
  endpoint  String   @unique
  p256dh    String   @map("p256dh")
  auth      String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("push_subscriptions")
}
