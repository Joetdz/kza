FROM node:20-alpine AS builder
WORKDIR /app

ARG VITE_API_URL
ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_ANON_KEY

ENV VITE_API_URL=$VITE_API_URL
ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL
ENV VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY

COPY package.json package-lock.json turbo.json ./
COPY packages ./packages
# Ikele reuses the storefront pages of the web app (@web alias): both are needed.
COPY apps/web/package.json ./apps/web/
COPY apps/ikele/package.json ./apps/ikele/

RUN npm ci

COPY apps/web ./apps/web
COPY apps/ikele ./apps/ikele
RUN cd apps/ikele && npm run build

FROM nginx:alpine
COPY --from=builder /app/apps/ikele/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
